# Local kubeconfigs and anything a run writes out
*.kubeconfig
kubeconfig-*
.tmp/
out/

# Built binaries of the demo app (build with: go build -o routedemo ./demos/09-routes/app)
demos/09-routes/app/routedemo
bin/
# demo 40 shopctl cross-compiled binaries (build.sh writes these; bin/ also matches)
demos/40-shop-mesh-phase0/client/go/shopctl/bin/

# demo 46 fabric password (copy fabric/.env.example)
demos/46-bgp-fabric/fabric/.env
demos/46-bgp-fabric-colima/fabric/.env

# The pinned bgp-fabric checkout (scripts/bgp-fabric-fetch.sh). Anchored, so
# it ignores this one directory and not every `static/vendor/` a demo might
# ever carry — bgp-fabric's dashboard ships one, and an un-anchored `vendor/`
# would swallow it without a word.
/vendor/
