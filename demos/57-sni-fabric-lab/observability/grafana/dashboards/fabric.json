          },
          "expr": "sum(rate(envoy_cluster_upstream_rq_xx_total{envoy_cluster_name=\"orders_api_internal\",envoy_response_code_class=\"5\"}[5m]))",
          "legendFormat": "5xx that reached the worker (after retries)",
          "range": true
