{
  "uid": "tut-3-colour",
  "title": "Grafana 3 · Colour that means something",
  "description": "Colour is a signal: one colour for a ranking, a fixed colour per meaning, thresholds for a quantity, and why a palette-by-index lies.",
  "tags": [
    "tutorial"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_node_info, cluster)",
        "query": {
          "query": "label_values(kube_node_info, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)",
        "query": {
          "query": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
