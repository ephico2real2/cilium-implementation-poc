  "links": [],
  "panels": [
    {
      "type": "bargauge",
      "title": "Pods per namespace (top 10)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 32,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(10, count by (namespace) (kube_pod_info{cluster=~\"$cluster\"}))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Pod count per namespace as a ranking: one colour, the length is the count.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 1
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\nOne colour. The bar's length is the count; a colour per namespace would mean nothing and change every time a namespace appears."
      },
      "pluginVersion": "13.2.1",
      "id": 2
    },
    {
      "type": "stat",
      "title": "Pod phases",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (phase) (kube_pod_status_phase{cluster=~\"$cluster\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{phase}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Pod phase counts with a fixed colour per meaning, set by a byName override.",
      "id": 3
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\nFixed colour per MEANING: Running is always green, Failed always red — on every dashboard, every load. Set with a byName override, never by palette position."
      },
      "pluginVersion": "13.2.1",
      "id": 4
    },
    {
      "type": "gauge",
      "title": "Deployments: available / desired",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto",
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(kube_deployment_status_replicas_available{cluster=~\"$cluster\"}) / sum(kube_deployment_spec_replicas{cluster=~\"$cluster\"})",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Available over desired deployments — a quantity on a 0–1 scale, coloured by threshold.",
      "id": 5
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\nThresholds colour a QUANTITY: below 90 % orange, below that red, 100 % green. Thresholds are for numbers on a scale; fixed colours are for categories."
      },
      "pluginVersion": "13.2.1",
      "id": 6
    },
