          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(5, sum by (namespace) (kube_pod_container_status_restarts_total{cluster=~\"$cluster\"}))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
