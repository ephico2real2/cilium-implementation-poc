          "expr": "count by (namespace) (kube_pod_info{cluster=~\"$cluster\", namespace=~\"team-.*|cf2cnp-lab.*\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{namespace}}"
