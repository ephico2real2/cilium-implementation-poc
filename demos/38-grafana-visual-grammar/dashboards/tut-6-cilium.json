{
  "uid": "tut-6-cilium",
  "title": "Grafana 6 · Now Cilium",
  "description": "The same grammar on Hubble metrics — pulse, verdict over time, drops ranked by reason.",
  "tags": [
    "tutorial"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_node_info, cluster)",
        "query": {
          "query": "label_values(kube_node_info, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)",
        "query": {
          "query": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Flows/s per cluster",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "suffix: flows/s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (cluster) (rate(hubble_flows_processed_total[5m]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{cluster}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Hubble flows per second, one number per cluster — the pulse.",
      "id": 1
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\nA number now, per cluster — the pulse. Stat with sparkline."
      },
      "pluginVersion": "13.2.1",
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Flows/s by verdict",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: flows/s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "insertNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "FORWARDED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DROPPED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "REDIRECTED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "AUDIT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (verdict) (rate(hubble_flows_processed_total{cluster=~\"$cluster\"}[5m]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{verdict}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Flow rate by verdict over time; DROPPED is red on every Cilium dashboard in this lab.",
      "id": 3
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\nOver time, by verdict, fixed colours: DROPPED is red on every Cilium dashboard in this lab. Same meaning, same colour."
      },
      "pluginVersion": "13.2.1",
      "id": 4
    },
    {
      "type": "bargauge",
      "title": "Drops/s by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-red"
          },
          "unit": "suffix: drops/s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "top",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 32,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(hubble_drop_total{cluster=~\"$cluster\"}[5m]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Drop rate by reason, ranked — POLICY_DENIED first is policy doing its job.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 5
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\nA ranking of why packets are dropped. Bars, sorted, one colour — the length is the rate. POLICY_DENIED first means policy is doing its job; anything else first means something is broken."
      },
      "pluginVersion": "13.2.1",
      "id": 6
    },
    {
      "type": "text",
      "title": "From here",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "The same grammar applied to Loki flow logs lives on the observer dashboard: /d/hubble-observer-23862.\n\nThe panel-by-panel notes for that dashboard are docs/OBSERVER-DASHBOARD-PANELS.md in this repository."
      },
      "pluginVersion": "13.2.1",
      "id": 7
    }
  ]
}
