{
  "uid": "tut-1-question",
  "title": "Grafana 1 · The question decides the chart",
  "description": "Seven questions, seven visualizations — the chart is chosen by what you want to know, not by what looks busy.",
  "tags": [
    "tutorial"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_node_info, cluster)",
        "query": {
          "query": "label_values(kube_node_info, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)",
        "query": {
          "query": "label_values(node_uname_info{cluster=~\"$cluster\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "A number now — CPU busy %",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",cluster=~\"$cluster\"}[5m])) * 100",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "CPU busy now, per node — one number and a sparkline, coloured by threshold.",
      "id": 1
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\n**Stat**: one number per node, now, with a sparkline for the trend. Colour from thresholds — 70 % orange, 90 % red — so the colour answers \"is this fine?\"."
      },
      "pluginVersion": "13.2.1",
      "id": 2
    },
    {
      "type": "gauge",
      "title": "A number against a limit — memory used %",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto",
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\"}) * 100",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Memory used against the only real ceiling that matters: 100 % of RAM.",
      "id": 3
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\n**Gauge**: only when there is a real ceiling (100 % of RAM). The needle's position IS the message; without a limit a gauge is decoration."
      },
      "pluginVersion": "13.2.1",
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "A number over time — load average (1 m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "insertNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "node_load1{cluster=~\"$cluster\"}",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Load average over the window, one line per node, so you can see when it moved.",
      "id": 5
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\n**Time series**: when the question is \"what happened, and when\". One line per node; the legend names them."
      },
      "pluginVersion": "13.2.1",
      "id": 6
    },
    {
      "type": "piechart",
      "title": "A share of a whole — CPU time by mode on $node",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "idle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "user"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "system"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "iowait"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "steal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "displayLabels": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$node\"}[5m]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{mode}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "CPU time on one node split by mode — the slices are the whole of that CPU.",
      "id": 7
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\n**Pie**: the slices add up to 100 % of one CPU's time, and there are five or six of them — the one case a pie is right. Fixed colours: idle grey, user blue, system orange, iowait red. idle is grey on purpose: it is the part of the whole that carries no information."
      },
      "pluginVersion": "13.2.1",
      "id": 8
    },
    {
      "type": "bargauge",
      "title": "A ranking — network receive by interface (top 5)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 32,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "topk(5, sum by (instance, device) (rate(node_network_receive_bytes_total{cluster=~\"$cluster\",device!=\"lo\"}[5m])))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{instance}} {{device}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "Top 5 receive rates by interface — a ranking, so bars, sorted.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 9
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\n**Bar gauge**: a ranking is a comparison between categories — bars sorted by value, the number beside each name. One colour: the length already carries the size."
      },
      "pluginVersion": "13.2.1",
      "id": 10
    },
    {
      "type": "state-timeline",
      "title": "A state over time — node-exporter up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0,
            "spanNulls": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "up{job=~\".*node-exporter.*\",cluster=~\"$cluster\"}",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "node-exporter up or down as a band — how long each state lasted.",
      "id": 11
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\n**State timeline**: a discrete state per moment — up/down, phase, verdict. The colour band shows how long each state lasted."
      },
      "pluginVersion": "13.2.1",
      "id": 12
    },
    {
      "type": "table",
      "title": "Rows — node facts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "node_uname_info{cluster=~\"$cluster\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "pluginVersion": "13.2.1",
      "description": "One row of uname facts per node; hide the columns that carry nothing.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "container": true,
              "endpoint": true,
              "service": true,
              "pod": true,
              "namespace": true,
              "domainname": true
            }
          }
        }
      ],
      "id": 13
    },
    {
      "type": "text",
      "title": "",
      "description": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "<!-- caption -->\n\n**Table**: when the reader needs every row, not a shape. Hide the columns that carry nothing."
      },
      "pluginVersion": "13.2.1",
      "id": 14
    },
    {
      "type": "text",
      "title": "How to read this page",
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "options": {
        "mode": "markdown",
        "content": "- a number now → stat\n- against a limit → gauge\n- over time → time series\n- share of a whole → pie (≤ 6 slices)\n- ranking → bar gauge\n- state over time → state timeline\n- every row → table"
      },
      "pluginVersion": "13.2.1",
      "id": 15
    }
  ]
}
