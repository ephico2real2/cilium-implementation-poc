# Same shape as demo 09: static Go binary on distroless. One image, four roles (-mode).
#   docker build -t bankdemo:local -f demos/15-bank/app/Containerfile demos
#   kind load docker-image bankdemo:local --name poc1 && kind load docker-image bankdemo:local --name poc2
# golang:1.25 — pgx v5.11 requires go >= 1.25 (go.mod says so); a 1.24 builder fails at `go mod download`.
# Layout mirrors the repo (WORKDIR /src/15-bank/app) so replace jsonview => ../../shared/jsonview
# resolves both on the host and in the image.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY shared/jsonview/ ./shared/jsonview/
COPY 15-bank/app/go.mod 15-bank/app/go.sum ./15-bank/app/
WORKDIR /src/15-bank/app
RUN go mod download
COPY 15-bank/app/main.go .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /bankdemo .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /bankdemo /bankdemo
USER nonroot:nonroot
ENTRYPOINT ["/bankdemo"]
