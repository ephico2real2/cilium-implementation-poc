{
  "viewport": {
    "width": 1600,
    "height": 1100
  },
  "resolve": {
    "grafana.poc.local": "${GW}",
    "cf2cnp.poc.local": "${GW}",
    "hubble.poc.local": "${GW}"
  },
  "login": {
    "url": "https://grafana.poc.local/login",
    "user": [
      "input[name=user]",
      "admin"
    ],
    "password": [
      "input[name=password]",
      "${GRAFANA_PASSWORD}"
    ],
    "submit": "button[type=submit]"
  },
  "pages": [
    {
      "name": "grafana-hubble-network-overview",
      "evidence": "panels",
      "url": "https://grafana.poc.local/d/nlsO8tYVz/hubble-network-overview-namespace?orgId=1&from=now-30m&to=now&var-cluster=poc1&var-source_namespace=cf2cnp-lab30&var-destination_namespace=cf2cnp-lab30"
    },
    {
      "name": "grafana-hubble-l7-http",
      "evidence": "panels",
      "url": "https://grafana.poc.local/d/3g264CZVz/hubble-l7-http-metrics-by-workload?orgId=1&from=now-30m&to=now&var-cluster=poc1&var-destination_namespace=cf2cnp-lab30&var-destination_workload=shop-frontend&var-reporter=server&var-source_namespace=cf2cnp-lab30&var-source_workload=All"
    },
    {
      "name": "grafana-hubble-dns",
      "evidence": "panels",
      "url": "https://grafana.poc.local/d/_f0DUpY4k/hubble-dns-overview-namespace?orgId=1&from=now-30m&to=now&var-cluster=poc1&var-source_namespace=cf2cnp-lab&var-destination_namespace=All"
    },
    {
      "name": "grafana-hubble-metrics",
      "evidence": "panels",
      "url": "https://grafana.poc.local/d/5HftnJAWz/hubble-metrics-and-monitoring?orgId=1&from=now-30m&to=now"
    },
    {
      "name": "grafana-cilium-metrics",
      "evidence": "panels",
      "url": "https://grafana.poc.local/d/vtuWtdumz/cilium-metrics?orgId=1&from=now-30m&to=now"
    },
    {
      "name": "grafana-policy-verdicts",
      "evidence": "panels",
      "url": "https://grafana.poc.local/d/hubble-policy-verdicts/hubble-policy-verdicts-namespace?orgId=1&from=now-30m&to=now&var-cluster=poc1&var-namespace=cf2cnp-lab30"
    },
    {
      "name": "grafana-hubble-observer-flows",
      "evidence": "panels",
      "settleSeconds": 180,
      "before": 8000,
      "url": "https://grafana.poc.local/d/hubble-observer-23862?orgId=1&from=now-30m&to=now"
    },
    {
      "name": "hubble-ui-namespaces",
      "evidence": "text",
      "settle": false,
      "before": 4000,
      "url": "http://${HUBBLE}/"
    },
    {
      "name": "hubble-ui-cf2cnp-lab30",
      "evidence": "text",
      "settle": false,
      "before": 2000,
      "url": "http://${HUBBLE}/",
      "actions": [
        {
          "click": "Choose namespace"
        },
        {
          "wait": 1500
        },
        {
          "fill": [
            "input[placeholder*='Filter namespaces']",
            "cf2cnp-lab30"
          ]
        },
        {
          "wait": 800
        },
        {
          "click": "cf2cnp-lab30"
        },
        {
          "wait": 12000
        }
      ]
    },
    {
      "name": "cf2cnp",
      "evidence": "title",
      "settle": false,
      "before": 3000,
      "url": "https://cf2cnp.poc.local/"
    },
    {
      "name": "grafana-policy-verdicts-bank",
      "evidence": "panels",
      "url": "https://grafana.poc.local/d/hubble-policy-verdicts/hubble-policy-verdicts-namespace?orgId=1&from=now-30m&to=now&var-cluster=poc1&var-namespace=bank"
    },
    {
      "name": "grafana-hubble-network-overview-bank",
      "evidence": "panels",
      "url": "https://grafana.poc.local/d/nlsO8tYVz/hubble-network-overview-namespace?orgId=1&from=now-30m&to=now&var-cluster=poc1&var-source_namespace=bank&var-destination_namespace=bank"
    },
    {
      "name": "hubble-ui-bank",
      "evidence": "text",
      "settle": false,
      "before": 2000,
      "url": "http://${HUBBLE}/",
      "actions": [
        {
          "click": "Choose namespace"
        },
        {
          "wait": 1500
        },
        {
          "fill": [
            "input[placeholder*='Filter namespaces']",
            "bank"
          ]
        },
        {
          "wait": 800
        },
        {
          "click": "bank"
        },
        {
          "wait": 12000
        }
      ]
    }
  ]
}
