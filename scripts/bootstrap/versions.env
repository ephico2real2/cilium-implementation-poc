# scripts/bootstrap/versions.env — the lab's tool pins, in ONE place. Sourced by scripts/bootstrap/ubuntu.sh (which installs
# them and exports them to the workflow through $GITHUB_ENV) and by scripts/bootstrap/macos.sh (which compares Homebrew's
# versions against them). Before this file the same numbers lived in three workflows' env: blocks and in docs/NEW-MAC.md's
# table. scripts/lab-up.sh keeps its own defaults for KIND_VERSION_WANT and CILIUM_VERSION; both bootstraps check that
# they agree with this file, so a pin bumped in one place fails loudly instead of drifting.
#
# Every value is what the Action ran green with (run 34998586044, 2026-09-15): kind and the node image are a pair
# (clusters/ci/*.yaml pins kindest/node:v1.36.4 by digest); cilium-cli 0.19.7 did not know 1.20's CiliumCIDRGroup v2
# ("no kind is registered for the type v2alpha1.CiliumCIDRGroupList" in the sysdump); helm is the version preinstalled
# on GitHub's ubuntu-24.04 image, the only one the lab has been measured with (Homebrew's stable is helm 4).
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.36.4
CILIUM_CLI_VERSION=v0.20.0
CILIUM_VERSION=1.20.1
HUBBLE_CLI_VERSION=1.19.4
HELM_VERSION=v3.21.4
