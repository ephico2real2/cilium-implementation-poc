# scripts/bgp-fabric.env — which bgp-fabric this lab builds against.
#
# The fabric, the dashboard and the router agent live in their own repository
# now (github.com/ephico2real2/bgp-fabric). This lab consumes them at a pinned
# commit rather than carrying a copy, because two copies of 7,000 lines drift
# and a gate that compares them only tells you afterwards.
#
# The commit is pinned, not the tag: a tag can be moved, and "which code was
# this lab built against" must have exactly one answer. The tag is recorded
# beside it so a reader can see which release the commit belongs to.
BGP_FABRIC_REPO=https://github.com/ephico2real2/bgp-fabric.git
BGP_FABRIC_TAG=v0.1.0
BGP_FABRIC_COMMIT=cda9c7c11e204e0abeccc68441ae9e5a417c4a71
